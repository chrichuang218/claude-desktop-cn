{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude 中文助手",
  "version": "0.2.2",
  "identifier": "com.chrichuang218.claudewindowscn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude 中文助手",
        "width": 736,
        "height": 576,
        "minWidth": 360,
        "minHeight": 320,
        "preventOverflow": true,
        "decorations": false,
        "backgroundColor": "#faf9f6",
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
